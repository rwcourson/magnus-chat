# ── AI Gateway (AI SDK 7) ──────────────────────────────────────────
# Get a key: https://vercel.com/ai-gateway  (or `vercel env pull` for OIDC)
AI_GATEWAY_API_KEY=

# Optional: OIDC from Vercel (preferred on Vercel + after `vercel env pull`)
# VERCEL_OIDC_TOKEN=

# Model — provider/model form for AI Gateway
# Example currently used: google/gemma-4-31b-it
MAGNUS_MODEL=google/gemma-4-31b-it

# Force local mock replies even when gateway is configured (1/true)
# MAGNUS_AI_MOCK=1
